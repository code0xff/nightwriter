# Nightwriter API — environment
# Copy to `.env` (git-ignored) and adjust. Loaded by src/index.ts via dotenv.
# Full reference: README.md → Configuration.

# --- server ---
# PORT=8787
# HOST=127.0.0.1
# CORS_ORIGIN=http://localhost:5172

# --- jobs / subprocess ---
# NIGHTWRITER_MAX_CONCURRENCY=2
# NIGHTWRITER_JOB_TIMEOUT_MS=120000
# NIGHTWRITER_ARTIFACT_TTL_MS=1800000
# NIGHTWRITER_WORK_ROOT=

# --- CLI binaries ---
# NIGHTWRITER_CLAUDE_BIN=claude
# NIGHTWRITER_CODEX_BIN=codex

# --- storage ---
# NIGHTWRITER_DATA_ROOT=./data
# NIGHTWRITER_DB=sqlite
# NIGHTWRITER_SQLITE_PATH=

# --- auth (admin seed) ---
# Set a password to control the admin login; if unset, one is generated and
# logged once at startup.
NIGHTWRITER_ADMIN_USERNAME=admin
NIGHTWRITER_ADMIN_PASSWORD=

# HMAC secret for session tokens; generated + persisted if unset.
NIGHTWRITER_SESSION_SECRET=
# NIGHTWRITER_SESSION_TTL_MS=604800000

# --- passkeys (WebAuthn) ---
# NIGHTWRITER_RP_ID=localhost
# NIGHTWRITER_RP_NAME=Nightwriter
# NIGHTWRITER_ORIGIN=http://localhost:5172
